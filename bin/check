#!/usr/bin/env bash
# check-ip-literals — local guard against hard-coded tailnet addresses in this repo.
#
# Scans tracked and untracked-but-unignored files for IPv4 literals in the tailnet
# range (100.64/10). Documents (*.md), tests/fixtures, and entries explicitly listed in
# .ip-literals-allow are skipped. No network access, no GitHub Actions.
#
# Usage: bin/check [--verbose]
# Exit 0 = clean, 1 = literal tailnet IP found, 2 = setup error.
# Allowlist format (one per line, pipe-separated; '#' starts a comment):
#   <path>|<address>|<reason>
# Only that exact path+address pair is exempt; a new address in the same file still fails.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERBOSE=0
for arg in "$@"; do
  case "$arg" in
    --verbose|-v) VERBOSE=1;;
    -h|--help) sed -n '2,12p' "$0"; exit 0;;
    *) echo "check-ip-literals: unknown argument: $arg" >&2; exit 2;;
  esac
done

if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "check-ip-literals: not a git work tree: $ROOT" >&2
  exit 2
fi

ALLOW="$ROOT/.ip-literals-allow"
allow_paths=(); allow_addrs=(); allow_reasons=()
if [ -r "$ALLOW" ]; then
  while IFS='|' read -r apath aaddr areason; do
    case "$apath" in ''|'#'*) continue;; esac
    allow_paths+=("${apath#./}"); allow_addrs+=("$aaddr"); allow_reasons+=("$areason")
  done < "$ALLOW"
fi

# IPv4 address inside the tailnet range; boundary guards keep longer octets and numeric prefixes out.
ADDR='100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.([0-9]{1,3})\.([0-9]{1,3})'
FULL="(^|[^0-9.])${ADDR}($|[^0-9])"

files=0; allowed=0; fails=0
while IFS= read -r -d '' f; do
  case "$f" in
    *.md|*.markdown|*.rst) continue;;
    docs/*|*/docs/*) continue;;
    test/*|*/test/*|tests/*|*/tests/*) continue;;
    */fixtures/*|fixtures/*) continue;;
    *.test.*|*.spec.*) continue;;
    .ip-literals-allow) continue;;
  esac
  [ -f "$ROOT/$f" ] || continue
  files=$((files + 1))
  matches="$(grep -nEI -- "$FULL" "$ROOT/$f" 2>/dev/null)" || continue
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    ln="${m%%:*}"
    text="${m#*:}"
    raw_addrs="$(printf '%s\n' "$text" | grep -oE -- "$FULL" || true)"
    for raw in $raw_addrs; do
      addr="$(printf '%s\n' "$raw" | grep -oE -- "$ADDR" | head -1)"
      is_allowed=0
      i=0
      while [ "$i" -lt "${#allow_paths[@]}" ]; do
        if [ "$f" = "${allow_paths[$i]}" ] && [ "$addr" = "${allow_addrs[$i]}" ]; then
          is_allowed=1
          if [ "$VERBOSE" = 1 ]; then
            echo "ALLOW $f:$ln $addr (${allow_reasons[$i]:-listed})"
          fi
          break
        fi
        i=$((i + 1))
      done
      if [ "$is_allowed" = 1 ]; then
        allowed=$((allowed + 1))
        continue
      fi
      fails=$((fails + 1))
      shown="${text#"${text%%[![:space:]]*}"}"
      [ "${#shown}" -gt 160 ] && shown="${shown:0:157}..."
      echo "FAIL: literal tailnet IP $addr in $f:$ln"
      echo "      $shown"
    done
  done <<< "$matches"
done < <(git -C "$ROOT" ls-files -z --cached --others --exclude-standard)

if [ "$fails" -ne 0 ]; then
  echo "FAIL: $fails literal tailnet IP(s) in code/config; read them from env, a git-external config file, or tailnet node identity instead"
  exit 1
fi
echo "PASS: no literal tailnet IPs in code/config ($files files scanned, $allowed allowlisted)"
exit 0
